/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js build output ──────────────────────────────────
/.next/
/out/
/build

# ── Environment & Secrets (NEVER commit these) ────────────
.env
.env.*
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local

# Supabase / Database credentials
supabase/.temp/
supabase/functions/.env
**/service_role_key*
**/supabase_key*

# ── TypeScript ────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Testing ───────────────────────────────────────────────
/coverage

# ── Vercel ────────────────────────────────────────────────
.vercel

# ── Misc ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.pem

# ── Logs ─────────────────────────────────────────────────
